<!doctype html>
<html lang="ru">
  <%- include('partials/head', { title: 'Main Page', includeGTAG: true }) %>

  <body>
    <%- include('partials/menu') %>
    <h1>Stories</h1>

    <section>
      <ul>
        <% stories.forEach(story => { %>
          <li><a href="/story?id=<%= story.id %>"><%= story.title %></a></li>
        <% }) %>
      </ul>
    </section>
  </body>
</html>
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta
      name="viewport"
      content="width=device-width"
    >
    <title>Main page</title>

    <style>
      body {
        font-family: sans-serif;
        max-width: 700px;
        margin: 40px auto;
        padding: 0 20px;
      }

      input {
        padding: 8px;
        margin: 4px 0;
      }

      button {
        padding: 8px 12px;
        cursor: pointer;
      }

      section {
        margin-bottom: 30px;
      }
    </style>

  </head>

  <body>
    <h1>Stories</h1>

    <section>
      <ul>
        <% stories.forEach(story => { %>
          <li><a href="/story?id=<%= story.id %>"><%= story.title %></a></li>
        <% }) %>
      </ul>
    </section>
  </body>
</html>
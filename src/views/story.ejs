<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta
      name="viewport"
      content="width=device-width"
    >
    <title>Story</title>

    <style>
      body {
        font-family: sans-serif;
        max-width: 700px;
        margin: 40px auto;
        padding: 0 20px;
      }

      input {
        padding: 8px;
        margin: 4px 0;
      }

      button {
        padding: 8px 12px;
        cursor: pointer;
      }

      section {
        margin-bottom: 30px;
      }

      pre {
        white-space: pre-wrap;
        word-wrap: break-word;
      }
    </style>

  </head>

  <body>
    <p>
      <a href="/">Back to Main Page</a>
    </p>

    <h1><%= title %></h1>

    <section>
      <pre><%= content %></pre>
    </section>

    <p>
      <a href="/">Back to Main Page</a>
    </p>
  </body>
</html>
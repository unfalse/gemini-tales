<!doctype html>
<html lang="ru">
  <%- include('partials/head', { title: 'Login', includeGTAG: false }) %>

  <body>
    <%- include('partials/menu') %>

    <h1>Welcome to the Login Page</h1>

    <% if (message) { %>
      <p class="error"><%= message %></p>
    <% } %>

    <section>
      <h2>Login</h2>

      <form
        method="POST"
        action="/login"
      >
        <input
          name="username"
          placeholder="Username"
          required
        >

        <input
          name="password"
          type="password"
          placeholder="Password"
          required
        >

        <button>
          Login
        </button>
      </form>
    </section>

  </body>
</html>
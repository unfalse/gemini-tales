<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta
      name="viewport"
      content="width=device-width"
    >
    <title>Login</title>

    <style>
      body {
        font-family: sans-serif;
        max-width: 700px;
        margin: 40px auto;
        padding: 0 20px;
      }

      input {
        padding: 8px;
        margin: 4px 0;
      }

      button {
        padding: 8px 12px;
        cursor: pointer;
      }

      section {
        margin-bottom: 30px;
      }
    </style>

  </head>

  <body>
    <h1>Welcome to the Login Page</h1>

    <section>
      <h2>Login</h2>

      <form
        method="POST"
        action="/login"
      >
        <input
          name="username"
          placeholder="Username"
          required
        >

        <input
          name="password"
          type="password"
          placeholder="Password"
          required
        >

        <button>
          Login
        </button>
      </form>
    </section>

  </body>
</html>
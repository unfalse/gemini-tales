<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta
      name="viewport"
      content="width=device-width"
    >
    <title>Prompts</title>

    <style>
      body {
        font-family: sans-serif;
        max-width: 700px;
        margin: 40px auto;
        padding: 0 20px;
      }

      input {
        padding: 8px;
        margin: 4px 0;
      }

      button {
        padding: 8px 12px;
        cursor: pointer;
      }

      section {
        margin-bottom: 30px;
      }
    </style>

  </head>

  <body>
    <h1>Prompts</h1>

    <section>
      <h2>Enter a new prompt</h2>

      <form
        method="POST"
        action="/add-prompt"
      >
        <p>
          <input
            name="title"
            placeholder="Title"
            required
          >
        </p>
        <p>
          <textarea
            name="prompt"
            id="promptInput"
            placeholder="Enter your prompt here..."
            rows="4"
            cols="50"
          ></textarea>
        </p>

        <p>
          <button id="submitPromptButton">Submit Prompt</button>
        </p>

      </form>

    </section>

    <section>
      <h2>Available Prompts</h2>

      <ul>
        <% prompts.forEach(prompt => { %>
          <li><%= prompt.title %>: <%= prompt.text %> <a href="/generate?id=<%= prompt.id %>">GENERATE</a></li>
        <% }) %>
      </ul>
    </section>
  </body>
</html>
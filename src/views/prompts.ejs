<!doctype html>
<html lang="ru">
  <%- include('partials/header', { title: 'Prompts' }) %>

  <body>
    <h1>Prompts</h1>

    <section>
      <h2>Enter a new prompt</h2>

      <form
        method="POST"
        action="/add-prompt"
      >
        <p>
          <input
            name="title"
            placeholder="Title"
            required
          >
        </p>
        <p>
          <textarea
            name="prompt"
            id="promptInput"
            placeholder="Enter your prompt here..."
            rows="4"
            cols="50"
          ></textarea>
        </p>

        <p>
          <button id="submitPromptButton">Submit Prompt</button>
        </p>

      </form>

    </section>

    <section>
      <h2>Available Prompts</h2>

      <ul>
        <% prompts.forEach(prompt => { %>
          <li><%= prompt.title %>: <%= prompt.text %> <a href="/generate?id=<%= prompt.id %>">GENERATE</a></li>
        <% }) %>
      </ul>
    </section>
  </body>
</html>
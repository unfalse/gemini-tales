    <meta charset="UTF-8">
    <% if (includeGTAG) { %>
    <script>
        (function () {
            try {
                if (localStorage.getItem('site-lang') === 'en') location.replace('index.html' + location.hash);
            } catch (e) {}
        })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NBD1GTHV6H"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-NBD1GTHV6H');
    </script>
    <% } %>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    >
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
  </head>